rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isValidBlueprint(data) {
      return data.keys().hasAll([
        'event_name', 'organization', 'city', 'event_type', 
        'participants', 'committee_count', 'budget', 'blueprint_scale', 
        'burnout_risk', 'operational_complexity', 'coordination_intensity', 
        'wellbeing_risk_level', 'timestamp'
      ]) && data.keys().size() == 13
      && data.event_name is string && data.event_name.size() <= 200
      && data.organization is string && data.organization.size() <= 200
      && data.city is string && data.city.size() <= 100
      && data.event_type is string && data.event_type.size() <= 50
      && data.participants is number && data.participants >= 0
      && data.committee_count is number && data.committee_count >= 0
      && data.budget is number && data.budget >= 0
      && data.blueprint_scale is string
      && data.burnout_risk is number && data.burnout_risk >= 1 && data.burnout_risk <= 100
      && data.operational_complexity is number && data.operational_complexity >= 1 && data.operational_complexity <= 100
      && data.coordination_intensity is number && data.coordination_intensity >= 1 && data.coordination_intensity <= 100
      && data.wellbeing_risk_level in ['Green', 'Amber', 'Red']
      && data.timestamp is number;
    }

    match /blueprints/{blueprintId} {
      allow create: if isValidId(blueprintId) && isValidBlueprint(request.resource.data);
      // No public read for now to prevent scraping, but ready for future analytics if needed (with auth)
      allow read, update, delete: if false; 
    }
  }
}
