rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['papadaan49@gmail.com', 'orangmelayu9@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidAppSetting(data) {
      return data.keys().hasAll(['value', 'updatedAt'])
        && data.value is string
        && data.updatedAt == request.time;
    }

    function isValidBlueprint(data, isUpdate) {
      return data.keys().hasAll(['data', 'originalData', 'ownerId', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && (data.get('collaborators', []) is list)
        && (data.get('isPublic', false) is bool)
        && (isUpdate || data.createdAt == request.time)
        && data.updatedAt == request.time;
    }

    // --- Match Blocks ---

    match /users/{userId} {
      match /public/profile {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    match /users_by_email/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == email;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId) && isValidAppSetting(incoming());
    }

    match /blueprints/{blueprintId} {
      allow get: if isValidId(blueprintId) && (
        existing().ownerId == request.auth.uid || 
        request.auth.uid in existing().get('collaborators', []) ||
        existing().get('isPublic', false) == true
      );

      allow list: if isSignedIn();

      allow create: if isValidId(blueprintId) && isSignedIn() && isValidBlueprint(incoming(), false) && incoming().ownerId == request.auth.uid;

      allow update: if isValidId(blueprintId) && isSignedIn() && isValidBlueprint(incoming(), true) && (
        (existing().ownerId == request.auth.uid || request.auth.uid in existing().get('collaborators', [])) 
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['data', 'originalData', 'collaborators', 'isPublic', 'updatedAt'])
      );

      allow delete: if isValidId(blueprintId) && isOwner(existing().ownerId);

      // --- Calendar Events ---
      match /calendar_events/{eventId} {
        function canAccessBlueprint() {
          let blueprint = get(/databases/$(database)/documents/blueprints/$(blueprintId)).data;
          return blueprint.ownerId == request.auth.uid || request.auth.uid in blueprint.get('collaborators', []) || blueprint.get('isPublic', false) == true;
        }
        
        function isValidCalendarEvent(data) {
          return data.keys().hasAll(['googleEventId', 'title', 'startTime', 'endTime', 'blueprintId', 'creatorId', 'createdAt'])
            && data.googleEventId is string
            && data.title is string && data.title.size() <= 200
            && data.blueprintId == blueprintId
            && data.creatorId == request.auth.uid
            && data.createdAt == request.time;
        }

        allow read: if isSignedIn() && canAccessBlueprint();
        allow create: if isValidId(eventId) && isSignedIn() && canAccessBlueprint() && isValidCalendarEvent(incoming());
        allow update: if isValidId(eventId) && isSignedIn() && canAccessBlueprint() && (
           incoming().creatorId == existing().creatorId && 
           incoming().googleEventId == existing().googleEventId &&
           incoming().createdAt == existing().createdAt &&
           incoming().blueprintId == existing().blueprintId
        );
        allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || isOwner(get(/databases/$(database)/documents/blueprints/$(blueprintId)).data.ownerId));
      }

      // --- Comments ---
      match /comments/{commentId} {
        function isCollaborator() {
          let blueprint = get(/databases/$(database)/documents/blueprints/$(blueprintId)).data;
          return blueprint.ownerId == request.auth.uid || request.auth.uid in blueprint.get('collaborators', []);
        }

        function isValidComment(data) {
          return data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
            && data.text is string && data.text.size() <= 1000
            && data.authorId == request.auth.uid
            && data.createdAt == request.time;
        }

        allow read: if isSignedIn() && isCollaborator();
        allow create: if isValidId(commentId) && isSignedIn() && isCollaborator() && isValidComment(incoming());
        allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isOwner(get(/databases/$(database)/documents/blueprints/$(blueprintId)).data.ownerId));
      }
    }

    // --- Organizations ---
    match /organizations/{orgId} {
      function isValidOrg(data) {
        return data.name is string && data.name.size() > 0 
          && data.totalEvents is number 
          && data.totalParticipants is number
          && data.totalBudget is number;
      }
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(orgId) && isValidOrg(incoming());
      allow delete: if isSignedIn() && isValidId(orgId);
    }
  }
}
